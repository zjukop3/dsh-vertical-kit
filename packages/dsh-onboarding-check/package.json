{
  "name": "dsh-onboarding-check",
  "version": "0.3.6",
  "description": "Onboarding doc hygiene: what must be installed first, a pasteable command, what success looks like, where to ask when it fails, and how long it takes — a doc with no time estimate does not get started.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "onboarding-check": "./bin/cli.js",
    "dsh-onboarding-check": "./bin/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "onboarding",
    "getting-started",
    "readme",
    "上手指南",
    "新人文档"
  ],
  "license": "MIT",
  "author": "zjukop3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjukop3/dsh-vertical-kit.git"
  },
  "homepage": "https://github.com/zjukop3/dsh-vertical-kit/tree/main/packages/dsh-onboarding-check"
}
