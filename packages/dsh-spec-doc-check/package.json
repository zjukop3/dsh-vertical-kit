{
  "name": "dsh-spec-doc-check",
  "version": "0.1.3",
  "description": "Spec-doc hygiene: the problem stated, acceptance criteria a reader could actually check, an explicit out-of-scope section, and no criterion written as a wish («体验良好» can be neither accepted nor rejected).",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "spec-doc-check": "./bin/cli.js",
    "dsh-spec-doc-check": "./bin/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "spec",
    "requirements",
    "acceptance-criteria",
    "需求文档检查",
    "验收标准"
  ],
  "license": "MIT",
  "author": "zjukop3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjukop3/dsh-vertical-kit.git"
  },
  "homepage": "https://github.com/zjukop3/dsh-vertical-kit/tree/main/packages/dsh-spec-doc-check"
}
