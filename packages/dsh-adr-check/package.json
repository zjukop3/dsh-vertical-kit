  "author": "zjukop3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjukop3/dsh-vertical-kit.git"
  },
  "homepage": "https://github.com/zjukop3/dsh-vertical-kit/tree/main/packages/dsh-adr-check"
}
