{
  "name": "dsh-plugin-entry-check",
  "version": "0.1.1",
  "description": "Check an awesome-dsh-plugin catalog entry before submitting it: filename, name/url agreement, subpackage path, the 23 categories, a bilingual description, the icon, and the aggregation-bundle hint. Sixteen rules, no network.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "plugin-entry-check": "./bin/cli.js",
    "dsh-plugin-entry-check": "./bin/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "locale"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "catalog",
    "entry",
    "lint",
    "插件目录",
    "提交检查"
  ],
  "license": "MIT",
  "author": "zjukop3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjukop3/dsh-vertical-kit.git"
  },
  "homepage": "https://github.com/zjukop3/dsh-vertical-kit/tree/main/packages/dsh-plugin-entry-check"
}
