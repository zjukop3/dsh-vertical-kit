{
  "name": "dsh-check-suite",
  "version": "0.1.5",
  "description": "One install for 34 document and delivery checks: commit messages, PR descriptions, release notes, ADRs, runbooks, handovers, invoices, expense claims, resumes, spec and test reports, plus table, outline, number, citation and hash checks. Each check contributes its own HTTP endpoint; every finding carries a line number.",
  "type": "module",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "commit-message",
    "conventional-commits",
    "git",
    "提交信息",
    "约定式提交",
    "dsh-bundle",
    "check-suite",
    "检查套件"
  ],
  "license": "MIT",
  "author": "zjukop3",
  "homepage": "https://github.com/zjukop3/dsh-vertical-kit/tree/main/packages/dsh-commit-msg-check",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjukop3/dsh-vertical-kit.git"
  },
  "dependencies": {
    "dsh-adr-check": "^0.2.4",
    "dsh-agreement-check": "^0.1.5",
    "dsh-api-doc-check": "^0.1.4",
    "dsh-bug-report-check": "^0.1.3",
    "dsh-commit-msg-check": "^0.3.3",
    "dsh-contributing-check": "^0.1.2",
    "dsh-dockerfile-check": "^0.1.3",
    "dsh-env-example-check": "^0.2.3",
    "dsh-expense-claim-check": "^0.1.3",
    "dsh-handover-check": "^0.2.5",
    "dsh-incident-report-check": "^0.1.4",
    "dsh-invoice-check": "^0.1.4",
    "dsh-license-check": "^0.2.3",
    "dsh-listing-check": "^0.2.2",
    "dsh-meeting-notes-check": "^0.1.5",
    "dsh-migration-guide-check": "^0.1.5",
    "dsh-onboarding-check": "^0.3.6",
    "dsh-ops-runbook-check": "^0.2.4",
    "dsh-perf-report-check": "^0.1.2",
    "dsh-plugin-entry-check": "^0.1.1",
    "dsh-plugin-package-check": "^0.1.0",
    "dsh-pr-description-check": "^0.2.3",
    "dsh-privacy-notice-check": "^0.1.4",
    "dsh-release-notes-check": "^0.3.3",
    "dsh-resume-check": "^0.1.6",
    "dsh-security-advisory-check": "^0.1.4",
    "dsh-spec-doc-check": "^0.1.5",
    "dsh-test-report-check": "^0.1.6",
    "dsh-weekly-report-check": "^0.1.3",
    "dsh-citelint": "^0.1.5",
    "dsh-hashcheck": "^0.1.4",
    "dsh-numberlint": "^0.1.4",
    "dsh-outline-lint": "^0.1.6",
    "dsh-tablelint": "^0.2.2"
  },
  "files": [
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ]
}
